# ZeroStunting AI — Backend Environment Variables
# Salin file ini ke .env dan isi dengan nilai yang sesuai

# ── DATABASE (Neon Serverless PostgreSQL) ─────────────────────────────────────
# Ambil Connection String dari dashboard Neon (https://console.neon.tech):
DATABASE_URL=postgresql://neondb_owner:your_password@ep-cool-snowflake-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Contoh lokal jika menggunakan PostgreSQL lokal:
# DATABASE_URL=postgresql://user:password@localhost:5432/zerostunting

# ── API KEYS ──────────────────────────────────────────────────────────────────
# Groq API untuk LLM (RAG advisory)
GROQ_API_KEY=your_groq_api_key_here

# Google Cloud Vision (OCR foto KMS)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ── APP CONFIG ────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,https://*.vercel.app

# ── SUPABASE (jika pakai Supabase Storage) ────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key
