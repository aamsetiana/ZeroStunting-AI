# ZeroStunting AI — Backend Environment Variables
# Salin file ini ke .env dan isi dengan nilai yang sesuai

# ── DATABASE ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/zerostunting
# Untuk Supabase:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── API KEYS ──────────────────────────────────────────────────────────────────
# Groq API untuk LLM (RAG advisory)
GROQ_API_KEY=your_groq_api_key_here

# Google Cloud Vision (OCR foto KMS)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ── APP CONFIG ────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,https://*.vercel.app

# ── SUPABASE (jika pakai Supabase Storage) ────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key
